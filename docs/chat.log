data: {"type": "canvas", "action": "create", "component": "course_info", "data": {"course_name": "短视频剧本创作与分镜设计实战", "course_level": "专业核心课", "target_audience": "影视制作/新媒体专业大三学生", "description": "本课程以都市武侠《老街暗锋》等真实剧本为教学载体，系统训练学生完成从剧本解析、分镜脚本撰写到动态分镜制作的全流程能力。通过真实项目案例，重点培养学生的镜头语言表达、节奏把控及传统文化元素创新转化能力，使学生能够在实际工作中应用所学知识和技能。", "total_theory_hours": 32, "total_practice_hours": 32}}
